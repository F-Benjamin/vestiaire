# Copiez ce fichier vers .env.local pour le développement local.
# Les valeurs réelles restent dans .env.local ou dans Netlify, jamais dans Git.

# Environnement applicatif : development, preview ou production.
APP_ENV=development

# Futures intégrations côté serveur.
MONGODB_URI=
MONGODB_DB_NAME=vestiaire
BETTER_AUTH_SECRET=
OPENAI_API_KEY=

# E-mails transactionnels d'authentification.
# Laissez false tant que Resend et le domaine expéditeur ne sont pas configurés.
EMAIL_AUTH_ENABLED=false
RESEND_API_KEY=
EMAIL_FROM=Wearsona <auth@votre-domaine.fr>
